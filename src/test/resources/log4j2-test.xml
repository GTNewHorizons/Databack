<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests' logging. Unlike LaunchWrapper's config, it doesn't scan net.minecraft for plugins, which would load every
     Minecraft class before the test mixins are in place (databack.test.support.TestMixins). -->
<Configuration status="WARN">
    <Appenders>
        <Console name="SysOut" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] [%logger]: %msg%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="SysOut" />
        </Root>
    </Loggers>
</Configuration>
